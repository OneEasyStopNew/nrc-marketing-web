  "name": "[SYNTHETIC] Staging recruitment advertising rules",
  "lifecycle_state": "ACTIVE",
  "is_synthetic": true,
  "rules": [
    {
      "rule_id": "REC-01",
      "rule_version": 1,
      "title": "No safety or effectiveness claims",
      "requirement": "Do not state or imply that the investigational treatment is safe or effective for the condition being studied.",
      "gate": "policy",
      "severity": "critical",
      "mandatory": true,
      "check_type": "semantic",
      "exact_wording": null,
      "prohibited_phrases": [
        "safe and effective",
        "proven",
        "cure",
        "cures"
      ],
      "applicability": {
        "input_kinds": [
          "brief",
          "text",
          "image"
        ],
        "channels": [],
        "post_formats": [],
        "languages": [],
        "audiences": [],
        "jurisdictions": [],
        "study_specific": false,
        "effective_from": null,
        "effective_to": null
      },
      "sources": [
        {
          "source_title": "[SYNTHETIC] Paraphrased public FDA guidance",
          "clause_ref": "FDA-1",
          "section": "Claims of safety or effectiveness",
          "page": 1,
          "language": "en",
          "excerpt": "[SYNTHETIC] Recruitment material must not say or suggest that an investigational treatment is safe or effective for the condition under study."
        },
        {
          "source_title": "[SYNTHETIC] Paraphrased public FDA guidance",
          "clause_ref": "FDA-1-ES",
          "section": "Afirmaciones de seguridad o eficacia",
          "page": 1,
          "language": "es",
          "excerpt": "[SYNTHETIC] El material de reclutamiento no debe decir ni sugerir que un tratamiento en investigación es seguro, eficaz o que cura la enfermedad en estudio."
        }
      ],
      "disclosures": [],
      "interpretations": [],
      "examples": [],
      "exceptions": []
    },
    {
