{
  "name": "nrc-marketing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NRC Marketing web application (React + TypeScript, Cognito sign-in, Marketing API)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:sim": "vite --mode simulation --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:build": "node scripts/check-build.mjs",
    "gen:api": "node scripts/gen-api-schemas.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.12",
    "@astryxdesign/theme-neutral": "^0.7.12",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "lottie-web": "^5.12.2",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.28.0",
    "simple-icons": "^16.37.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.12",
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.39.5",
    "@iconify-json/solar": "^1.2.13",
    "@iconify-json/tabler": "^1.2.43",
    "@playwright/test": "^1.49.1",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "msw": "^2.15.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
