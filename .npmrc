# Supply-chain settings (JS-75, JS-41). Read by npm 11.10+ locally and in CI.

# Only install versions published at least 7 days ago, so a freshly published
# (possibly hijacked) release is never pulled in. For an urgent fix, install
# that one package with --min-release-age=0 and say why in the pull request.
min-release-age=7

# No git, tarball or URL dependencies: everything comes from the registry.
allow-git=none

# Refuse to install on a Node version outside package.json "engines".
engine-strict=true
