# ---------------------------------------------------------------------------
# NRC Marketing web configuration. Copy to .env.local and edit.
# Every value here is public (it ends up in the browser bundle). Never put a
# client secret, provider key or token in this file.
# ---------------------------------------------------------------------------

# cognito    = real sign-in through the Cognito managed login (staging, production)
# simulation = labelled fixture identities for local development and tests only.
#              A production build refuses it unless VITE_ALLOW_SIMULATION=true.
VITE_AUTH_MODE=simulation
VITE_ALLOW_SIMULATION=false

# Marketing API base URL (API Gateway custom domain). Paths are /v1/marketing/...
# Leave empty to call the same origin.
VITE_API_BASE_URL=

# Cognito user pool and public app client (from OR-86). No client secret: this
# is a public client using authorization code + PKCE.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Managed login domain, e.g. https://nrc-marketing-stg.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# Space separated. marketing/api is the API scope (Bhushan to confirm the final name).
VITE_COGNITO_SCOPES=openid email profile marketing/api
